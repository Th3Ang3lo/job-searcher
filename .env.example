# Chave da API do LLM (formato OpenAI). Obrigatória nos modos hybrid e llm.
LLM_API_KEY="sua_chave_aqui"
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-v4-flash"

# Currículo em PDF (opcional): arquivo .pdf ou diretório com PDFs.
# O texto é enviado ao LLM como contexto adicional.
RESUME_PATH=""
RESUME_MAX_CHARS="8000"

# Filtro: hybrid (regras + LLM), keywords (só regras) ou llm (só LLM)
FILTER_MODE="hybrid"

# Nota mínima (0-100) para aceitar uma vaga no modo LLM
MATCH_THRESHOLD="70"

# Busca
SEARCH_DAYS_BACK="7"
PAGES_PER_QUERY="1"
# 0 = todos os resultados das páginas configuradas
MAX_JOBS_PER_QUERY="0"
# 0 = sem limite
MAX_JOBS_TOTAL="0"
REQUEST_DELAY_MS="1500"

# Arquivos
INTERESTS_FILE="interests.md"
OUTPUT_CSV="vagas.csv"
